{
  "name": "@postiz/grok-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 draft-only Grok worker for an internal Postiz deployment. Publishing is disabled.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "node --experimental-strip-types --test --test-reporter spec test/*.test.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "node --experimental-strip-types src/cli.ts --poll"
  },
  "dependencies": {
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "typescript": "5.5.4"
  }
}
