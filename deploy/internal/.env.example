# Copy to deploy/internal/.env and fill every blank.
# Do not commit .env. Values below are empty on purpose.
# Passwords must be URL-safe: letters, digits, underscore, hyphen.
# No real brand names, channel ids, or API keys belong in this file.

# Required pin. This fork does not publish an image.
# Upstream tag verified on 2026-11-09:
#   ghcr.io/gitroomhq/postiz-app:v2.25.3
#   @sha256:1e376ff2cb781022d528f171719cf174cf693a985a30cb40eefb13eae3ddda13
# That image is commit a5affe62, 59 commits behind this fork (4b7b9901).
# version.txt still says v1.47.0 and is not the image tag.
POSTIZ_IMAGE=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_PASSWORD=

TEMPORAL_POSTGRES_USER=
TEMPORAL_POSTGRES_PASSWORD=

JWT_SECRET=

# https://<your-internal-hostname> with no trailing slash. Do not invent one.
INTERNAL_PUBLIC_ORIGIN=

# Directory that contains tls.crt and tls.key. No certificate is committed.
INTERNAL_TLS_DIR=

# true after the first admin exists. false only while creating that account.
DISABLE_REGISTRATION=

# Separate database for the worker. Not the Postiz password.
GROK_WORKER_DB_PASSWORD=

# Loopback by default. Set a specific internal address only on your network.
INTERNAL_BIND_ADDRESS=127.0.0.1
